# =====================================================================
# PHARMAVIGIL: GIT IGNORE RULES
# =====================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
.vercel/

# Python bytecode & runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
venv*/
*venv/
.venv/
env/

# Data exports (preserve .gitkeep)
data/exports/*
!data/exports/.gitkeep

# IDE, OS & Editor artifacts
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Log files
*.log

# Project-local skills and installation metadata
/.agents/skills/
/.agents/skill-installations.json
/frontend/package-lock.json
node_modules/
/design_reference/
/frontend/dist/