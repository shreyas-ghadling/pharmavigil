# =====================================================================
# PHARMAVIGIL: ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=pharmavigil_secure_dcds_secret_key_2026

# MySQL Database Configuration (ACID Relational Core)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=pharmavigil_db
# Optional: Explicit path to mysql.exe client if not in PATH or standard Program Files folder
# MYSQL_BIN="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe"

# MongoDB Database Configuration (Adverse Event Telemetry)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=pharmavigil_db
MONGO_ADVERSE_COLLECTION=adverse_reports

# File Export Paths
EXPORTS_DIR=data/exports
